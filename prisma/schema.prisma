generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CompressionHistory {
  id           String   @id @default(uuid())
  fileName     String
  originalSize Int
  compressedSize Int
  ratio        Float
  createdAt    DateTime @default(now())
}
